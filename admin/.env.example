# Copy to .env.local and fill in. Supabase → Project Settings → API.

# Same project the mobile app points at.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️  SECRET. Bypasses row level security completely — this is what gives the
# panel unrestricted access. It has no NEXT_PUBLIC_ prefix, so Next.js keeps it
# out of the browser bundle; it is only ever read inside server actions.
# On Vercel add it under Settings → Environment Variables (all environments).
# Never paste it into a client component, and never commit .env.local.
SUPABASE_SERVICE_ROLE_KEY=
