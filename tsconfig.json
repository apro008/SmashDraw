{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "~/*": ["./src/*"]
    },
    "types": ["expo-router/types"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // Edge Functions are Deno, not React Native — they are type-checked by the
  // Supabase CLI, not by this project's tsc run.
  "exclude": ["node_modules", "supabase/functions"]
}
