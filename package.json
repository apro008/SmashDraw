{
  "name": "smashdraw",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:apk": "eas build -p android --profile preview",
    "build:production": "eas build -p android --profile production",
    "clean": "expo start --clear",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo/metro-runtime": "~55.0.9",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@supabase/supabase-js": "^2.49.4",
    "country-state-city": "^3.2.1",
    "expo": "~55.0.24",
    "expo-blur": "~55.0.14",
    "expo-calendar": "~55.0.14",
    "expo-constants": "~55.0.12",
    "expo-font": "~55.0.6",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.14",
    "expo-image-picker": "~55.0.17",
    "expo-linking": "~55.0.11",
    "expo-router": "~55.0.11",
    "expo-secure-store": "~55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.18",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-mmkv": "^3.3.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.7.4",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~55.0.8",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
