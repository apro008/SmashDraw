# Copy to .env and fill in.

# Supabase — Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Sign-In — Google Cloud Console > APIs & Services > Credentials
#
# Create three OAuth client IDs under one Google Cloud project:
#   Web      — paste its ID below AND into Supabase > Auth > Providers > Google
#   Android  — package com.smashdraw.app + SHA-1 from `eas credentials`
#   iOS      — bundle com.smashdraw.app
#
# Only the Web ID goes in the app. Android is matched by package + SHA-1 at run
# time, and it is the Web client that issues the ID token Supabase verifies.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# iOS only — leave blank until you set up the iOS build.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
